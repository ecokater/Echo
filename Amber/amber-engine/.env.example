# Amber Engine — environment config
# 复制为 .env 并填值。生产环境务必修改 SECRET_KEY 和 DATABASE_URL。

# ── 运行环境 ──────────────────────────────────────────────
# dev | prod  —— prod 会禁用 /api/billing/callback/dev 测试支付通道
ENV=prod
HOST=0.0.0.0
PORT=8000
# uvicorn 进程数。本架构为 I/O 密集型推理代理，单进程异步已够；
# 设 >1 会让 Janitor 后台任务在每个进程各跑一份，小机器保持 1。
WEB_CONCURRENCY=1

# ── 鉴权 / JWT ────────────────────────────────────────────
# 生产必须改成随机长串：python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=120
REFRESH_TOKEN_EXPIRE_DAYS=30

# ── 管理后台 ──────────────────────────────────────────────
# 逗号分隔的管理员手机号白名单；该账号首次访问 /api/admin/* 自动提权为 admin
ADMIN_PHONES=

# ── 平台模型（主版本：服务端持有 key，客户端不带 key 时用这套）──────────────
# 只用于首次播种 platform_config；之后以数据库为准，管理员可在后台实时改型号/单价/key。
# 硅基流动 SiliconFlow（OpenAI 兼容）。在 https://siliconflow.cn 申请 key 后填这里。
PLATFORM_API_KEY=
PLATFORM_BASE_URL=https://api.siliconflow.cn/v1
PLATFORM_MODEL_ID=Pro/deepseek-ai/DeepSeek-V3

# ── 数据库 ────────────────────────────────────────────────
# 留空 = 用 config.py 默认 SQLite（适合内测/小流量）
# Postgres（docker-compose 默认）示例：
# DATABASE_URL=postgresql+psycopg2://amber:amber_pwd@db:5432/amber
DATABASE_URL=

# ── 商业化（碎片计费，可用默认）────────────────────────────
SIGNUP_GIFT_FRAGMENTS=100
COST_PER_CHAT=1
COST_PER_DISTILL=20
COST_PER_SNAPSHOT=5
LOW_BALANCE_THRESHOLD=10
